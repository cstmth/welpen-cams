# Camera base URLs (without stream path — appended automatically via STREAM_QUALITY)
# CAMERA_<n>_ENABLED=true|false toggles a camera. Defaults to true if unset.
# A disabled camera still streams its own YouTube endpoint but shows the offline
# placeholder image and is excluded from the combined grid; its RTSP is never
# connected (CAMERA_<n>_RTSP not required, CAMERA_<n>_YOUTUBE still is).
#
# Any number of cameras is supported. Number them contiguously from 1
# (CAMERA_1_*, CAMERA_2_*, …); discovery stops at the first missing
# CAMERA_<n>_YOUTUBE. See cameras 5 and 6 near the bottom for how to add more.
# The combined 2x2 grid only ever uses the first four cameras.
CAMERA_1_ENABLED=true
CAMERA_1_RTSP=rtsp://user:password@192.168.1.100:554
CAMERA_1_YOUTUBE=rtmp://a.rtmp.youtube.com/live2/your-stream-key

CAMERA_2_ENABLED=true
CAMERA_2_RTSP=rtsp://user:password@192.168.1.101:554
CAMERA_2_YOUTUBE=rtmp://a.rtmp.youtube.com/live2/your-stream-key

CAMERA_3_ENABLED=true
CAMERA_3_RTSP=rtsp://user:password@192.168.1.102:554
CAMERA_3_YOUTUBE=rtmp://a.rtmp.youtube.com/live2/your-stream-key

CAMERA_4_ENABLED=true
CAMERA_4_RTSP=rtsp://user:password@192.168.1.103:554
CAMERA_4_YOUTUBE=rtmp://a.rtmp.youtube.com/live2/your-stream-key

# Additional cameras beyond the 2x2 grid — streamed individually only, not shown
# in the combined overview. Uncomment and fill in to add a fifth, sixth, etc.
CAMERA_5_ENABLED=true
CAMERA_5_RTSP=rtsp://user:password@192.168.1.104:554
CAMERA_5_YOUTUBE=rtmp://a.rtmp.youtube.com/live2/your-stream-key

CAMERA_6_ENABLED=true
CAMERA_6_RTSP=rtsp://user:password@192.168.1.105:554
CAMERA_6_YOUTUBE=rtmp://a.rtmp.youtube.com/live2/your-stream-key

# Stream quality: "sub" (low-res, good for WiFi) or "main" (full-res, needs Ethernet)
STREAM_QUALITY=sub

# Video encoder: "libx264" (CPU) or "h264_qsv" (Intel Quick Sync hardware)
VIDEO_ENCODER=h264_videotoolbox

# Combined 2x2 grid stream of the first four cameras (optional — remove or leave empty to disable)
COMBINED_YOUTUBE=rtmp://a.rtmp.youtube.com/live2/your-combined-stream-key

# Console log level (error, warn, info, debug). File logs always capture everything.
LOG_LEVEL=info

# Detect a visually frozen picture (freezedetect filter) on every camera source
# and on each camera's tile inside the combined stream, restarting the affected
# stream when triggered. Defaults to true if unset.
FREEZE_DETECT_ENABLED=true

# Unconditionally restart the combined stream every N minutes, regardless of
# health checks - a blunt mitigation for a tile that freezes without ever
# tripping stall/freeze detection. Unset or 0 disables it.
# COMBINED_RESTART_INTERVAL_MINUTES=30
