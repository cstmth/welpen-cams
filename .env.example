# Camera base URLs (without stream path — appended automatically via STREAM_QUALITY)
CAMERA_1_RTSP=rtsp://user:password@192.168.1.100:554
CAMERA_1_YOUTUBE=rtmp://a.rtmp.youtube.com/live2/your-stream-key

CAMERA_2_RTSP=rtsp://user:password@192.168.1.101:554
CAMERA_2_YOUTUBE=rtmp://a.rtmp.youtube.com/live2/your-stream-key

CAMERA_3_RTSP=rtsp://user:password@192.168.1.102:554
CAMERA_3_YOUTUBE=rtmp://a.rtmp.youtube.com/live2/your-stream-key

CAMERA_4_RTSP=rtsp://user:password@192.168.1.103:554
CAMERA_4_YOUTUBE=rtmp://a.rtmp.youtube.com/live2/your-stream-key

# Stream quality: "sub" (low-res, good for WiFi) or "main" (full-res, needs Ethernet)
STREAM_QUALITY=sub

# Video encoder: "libx264" (CPU) or "h264_qsv" (Intel Quick Sync hardware)
VIDEO_ENCODER=h264_qsv

# Combined 2x2 grid stream (optional — remove or leave empty to disable)
COMBINED_YOUTUBE=rtmp://a.rtmp.youtube.com/live2/your-combined-stream-key

# Console log level (error, warn, info, debug). File logs always capture everything.
LOG_LEVEL=info
